# Settings for THIS server. Copy to `.env` (not versioned) and uncomment only what this server
# needs to differ from the default.
#
#   cp .env.example .env
#
# Precedence: shell variable > this file > committed default in config/*.env.
# A change here requires rebuilding (or restarting the dev server): DefinePlugin injects the
# values at build time, not on the fly. Check what is being served with
#   curl -s <host>/ | grep build-commit
#
# Everything is commented out on purpose: an uncommented line PINS the value on this server, and a
# future change of the default in code would no longer reach it. An empty line (`ENABLE_GDPR=`)
# turns nothing off: it falls back to the default.

# --- Feature flags -------------------------------------------------------------------------
# Defaults: production / dev / test build.

# Granular locking and presence between users. 'on' or 'true' turn it on.
# The backend has its own flag and they must match. Default: on / on / on.
# ENABLE_CONCURRENCY_CONTROL=on

# Sign-up of new accounts from the login page. Default: true / true / false.
# ENABLE_REGISTRATION=true

# The whole GDPR surface (terms, privacy, consent). 'on' or 'true' turn it on.
# Do NOT turn it off with ENABLE_REGISTRATION at 'true' unless the backend also has its
# ENABLE_GDPR off: otherwise sign-up answers 400. Default: true / false / true.
# ENABLE_GDPR=true

# Offer CAMELOT when creating a project or changing its methodology. 'on' or 'true' turn it on.
# When off, only the classic methodology is offered; projects that are already CAMELOT keep
# working. Frontend only. Default: false / false / false.
# ENABLE_CAMELOT=true

# --- Sentry: reaches the browser -------------------------------------------------------------
# Empty = Sentry does not start. Default: empty in production.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Must match the release of the uploaded sourcemaps. Default: the package.json version, which is
# the same one the plugin below uses.
# SENTRY_RELEASE=

# --- Sentry: build time only, does NOT reach the bundle --------------------------------------
# With SENTRY_AUTH_TOKEN defined, `npm run build` uploads sourcemaps to Sentry and deletes them
# from dist/.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
