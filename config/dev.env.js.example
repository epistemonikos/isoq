'use strict'
const merge = require('webpack-merge')
const prodEnv = require('./prod.env')

module.exports = merge(prodEnv, {
  NODE_ENV: '"development"',
  PUBMED_API_KEY: '"PUBMED-API-KEY"',
  ENABLE_CONCURRENCY_CONTROL: '"on"',
  // 'on' o 'true' encienden toda la superficie GDPR. Cualquier otro valor, o
  // la ausencia del flag, la deja apagada. Cambiarlo exige reiniciar el
  // dev-server: DefinePlugin lo inyecta en build.
  ENABLE_GDPR: '"on"',
  SENTRY_DSN: '""'
})