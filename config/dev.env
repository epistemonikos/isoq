'use strict'
const merge = require('webpack-merge')
const prodEnv = require('./prod.env')

module.exports = merge(prodEnv, {
  NODE_ENV: '"development"',
  PUBMED_API_KEY: '"PUBMED-API-KEY"',
  ENABLE_CONCURRENCY_CONTROL: '"on"',
  // Dev corre con GDPR apagado para poder probar ese lado. Producción va en
  // 'true' (config/prod.env.js), así que al tocar algo de GDPR conviene
  // encender esto un rato y verificar que el lado encendido sigue sano.
  //
  // Cambiar cualquiera de los dos exige REINICIAR el dev-server: DefinePlugin
  // inyecta el valor en build, no en caliente.
  ENABLE_GDPR: '"false"',
  // Declarado explícitamente porque si no se hereda el valor de prod.env.js vía
  // webpack-merge. Estuvo apagado mientras el backend exigía terms_accepted sin
  // condición; desde que lee su propio ENABLE_GDPR (2026-08-17) el registro
  // funciona con GDPR apagado en las dos capas, así que vuelve a 'true'.
  // Requisito: el .env del backend debe tener ENABLE_GDPR alineado con éste.
  ENABLE_REGISTRATION: '"true"',
  SENTRY_DSN: '"https://f0dffcf3027e205843bae383ccc5d90d@o1421504.ingest.us.sentry.io/4511389583015936"'
})
