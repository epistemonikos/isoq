'use strict'
const merge = require('webpack-merge')
const prodEnv = require('./prod.env')
const { fromEnv } = require('./env')

module.exports = merge(prodEnv, {
  NODE_ENV: '"development"',
  PUBMED_API_KEY: '"PUBMED-API-KEY"',
  ENABLE_CONCURRENCY_CONTROL: fromEnv('ENABLE_CONCURRENCY_CONTROL', 'on'),
  // Dev runs with GDPR off so that side can be tested. Production uses 'true'
  // (config/prod.env.js), so when touching anything GDPR-related, turn this on for a
  // while and check that the enabled side is still healthy.
  //
  // Dev defaults are overridden from the root `.env`, same as in production.
  //
  // Changing either one requires RESTARTING the dev server: DefinePlugin injects the
  // value at build time, not on the fly.
  ENABLE_GDPR: fromEnv('ENABLE_GDPR', 'false'),
  // Declared explicitly because otherwise the prod.env.js value is inherited through
  // webpack-merge. It was off while the backend required terms_accepted
  // unconditionally; since the backend reads its own ENABLE_GDPR (2026-08-17),
  // registration works with GDPR off in both layers, so it is back to 'true'.
  // Requirement: the backend .env must have ENABLE_GDPR aligned with this one.
  ENABLE_REGISTRATION: fromEnv('ENABLE_REGISTRATION', 'true'),
  SENTRY_DSN: fromEnv('SENTRY_DSN', 'https://f0dffcf3027e205843bae383ccc5d90d@o1421504.ingest.us.sentry.io/4511389583015936')
})
